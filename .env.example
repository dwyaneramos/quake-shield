# QuakeShield — single root env file, shared by apps/web, apps/oracle, and
# packages/contracts. Copy to `.env` and fill in. Each sub-project loads this
# file directly (see AGENTS.md) — there is no per-app .env anymore.

# ── Shared wallet ────────────────────────────────────────────────────────
# Used both to deploy contracts (packages/contracts) and to sign the
# oracle's recordEarthquake() transactions (apps/oracle). Use separate keys
# if you want the deployer and oracle to be different wallets.
PRIVATE_KEY=your_private_key_here

# Which chain this oracle process submits earthquakes to: sepolia | fuji.
# Run a second oracle instance against the other chain with e.g.
# `NETWORK=fuji pnpm --filter oracle dev`.
NETWORK=sepolia

# ── Ethereum Sepolia (chainId 11155111) ─────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# Contract addresses (fill after `pnpm deploy:sepolia`)
QUAKE_SHIELD_ADDRESS_SEPOLIA=
USDC_ADDRESS_SEPOLIA=
NEXT_PUBLIC_QUAKE_SHIELD_ADDRESS_SEPOLIA=
NEXT_PUBLIC_MOCK_USDC_ADDRESS_SEPOLIA=
# Block QuakeShield was deployed at on Sepolia (limits event log scans on the claims page)
NEXT_PUBLIC_QUAKE_SHIELD_DEPLOY_BLOCK_SEPOLIA=
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ── Avalanche Fuji C-Chain (chainId 43113) ──────────────────────────────
FUJI_RPC_URL=https://avalanche-fuji-c-chain-rpc.publicnode.com
NEXT_PUBLIC_FUJI_RPC=https://avalanche-fuji-c-chain-rpc.publicnode.com
# Contract addresses (fill after `pnpm deploy:fuji`)
QUAKE_SHIELD_ADDRESS_FUJI=
USDC_ADDRESS_FUJI=
NEXT_PUBLIC_QUAKE_SHIELD_ADDRESS_FUJI=
NEXT_PUBLIC_MOCK_USDC_ADDRESS_FUJI=
# Block QuakeShield was deployed at on Fuji (limits event log scans on the claims page)
NEXT_PUBLIC_QUAKE_SHIELD_DEPLOY_BLOCK_FUJI=
SNOWTRACE_API_KEY=your_snowtrace_api_key_here

# ── Oracle settings ──────────────────────────────────────────────────────
POLL_INTERVAL_MS=30000
MIN_MAGITUDE_TO_REPORT=500

# ── Frontend ─────────────────────────────────────────────────────────────
# WalletConnect (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
